BOT_TOKEN=токен
OWNER_CHAT_ID=7857672682
WEBAPP_URL=https://afafafaf-production.up.railway.app/
PORT=3000
TWIBOOST_API_KEY=CnKHTkjxIgNntS22aIH5Qs4IWVlONnjLpgels0lYiC5efQYX5DenZO2HFcaZ

# Оплата картой через Smart Glocal (получить в @BotFather → Bot Settings →
# Payments → Smart Glocal). Без этого токена этот способ оплаты отключается
# сам, останутся остальные — сервер не упадёт.
SMARTGLOCAL_PROVIDER_TOKEN=токен_smart_glocal

# Оплата картой через Redsys (получить в @BotFather → Bot Settings →
# Payments → Redsys). Без этого токена этот способ оплаты отключается сам.
REDSYS_PROVIDER_TOKEN=токен_redsys

# Курс ⭐ → ₽ для оплаты картой (общий для обоих провайдеров — Smart Glocal
# и Redsys). ОБЯЗАТЕЛЬНО подставьте свой актуальный курс — значение ниже
# (2 ₽ за 1 ⭐) это заглушка, а не рыночная цена.
STARS_TO_RUB=2

# Необязательно: минимальная сумма инвойса в копейках (по умолчанию 10000 =
# 100 ₽), общая для обоих карточных провайдеров. Поменяйте, если у вас с
# провайдером другой минимум.
SMARTGLOCAL_MIN_KOPECKS=10000

# Необязательно: путь к файлу, где хранятся балансы/история заказов
# (по умолчанию data.json рядом с server.js). Если хостинг сбрасывает диск
# при каждом деплое/перезапуске — укажите путь на постоянный volume.
DATA_FILE=data.json
