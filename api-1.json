{
  "openapi": "3.1.0",
  "info": {
    "title": "Matrix SMS API",
    "version": "1.0.0",
    "description": "**Ключ:** бот → Профиль → API → выпустить (48 символов, показывается один раз). В каждый запрос: `Authorization: Bearer 9af723eec9b7ca421fc4513ebcbee719ec5fc1ab59d9f021`.\n\n<details><summary>Лимиты запросов</summary>\n\n| Группа | Лимит |\n|---|---|\n| `/balance`, `/prices`, `/orders` | 30 / 5 с |\n| `/buy` | 5 / 10 с |\n| `/orders/{id}/code`, `/tdata`, `/session` | 15 / 10 с |\n\nПревышение — `429`.\n\n</details>"
  },
  "servers": [
    {
      "url": "https://matrix-project.org/api"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Баланс",
      "description": "Данные аккаунта и текущий баланс"
    },
    {
      "name": "Каталог",
      "description": "Цены на аккаунты"
    },
    {
      "name": "Покупка",
      "description": "Покупка аккаунта"
    },
    {
      "name": "Заказы",
      "description": "Список ваших заказов и карточка заказа"
    },
    {
      "name": "Аккаунт",
      "description": "Код входа, tdata, завершение сессии купленного аккаунта"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token",
        "description": "Персональный ключ, выданный ботом (Профиль → API), длиной 48 символов."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "no_funds"
          },
          "msg": {
            "type": "string",
            "example": "На балансе не хватает средств"
          }
        }
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "user_id": {
            "type": "integer",
            "example": 84213
          },
          "username": {
            "type": "string",
            "nullable": true,
            "example": "nikita"
          },
          "balance_rub": {
            "type": "number",
            "example": 615
          },
          "orders_count": {
            "type": "integer",
            "example": 11
          }
        }
      },
      "PriceItem": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "example": "IN"
          },
          "country_label": {
            "type": "string",
            "example": "Индия"
          },
          "year": {
            "type": "integer",
            "nullable": true,
            "description": "год регистрации (только aged)",
            "example": 2019
          },
          "price_rub": {
            "type": "number",
            "example": 96
          }
        }
      },
      "Prices": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "newreg": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceItem"
            },
            "description": "свежие аккаунты"
          },
          "aged": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceItem"
            },
            "description": "аккаунты с отлёжкой"
          }
        }
      },
      "BuyRequest": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "newreg",
              "aged"
            ]
          },
          "country": {
            "type": "string",
            "description": "код страны (ISO2), необязательно",
            "example": "IN"
          },
          "year": {
            "type": "integer",
            "description": "год регистрации (только aged), необязательно",
            "example": 2019
          }
        }
      },
      "BuyAccountResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "order_id": {
            "type": "integer",
            "example": 7734
          },
          "kind": {
            "type": "string",
            "example": "newreg"
          },
          "country": {
            "type": "string",
            "example": "IN"
          },
          "phone": {
            "type": "string",
            "example": "+917042581396"
          },
          "login_code": {
            "type": "string",
            "nullable": true,
            "example": "48213"
          },
          "price_rub": {
            "type": "number",
            "example": 96
          },
          "new_balance_rub": {
            "type": "number",
            "example": 519
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer",
            "example": 7734
          },
          "kind": {
            "type": "string",
            "example": "newreg"
          },
          "status": {
            "type": "string",
            "example": "delivered"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+917042581396"
          },
          "price_rub": {
            "type": "number",
            "example": 96
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-14T09:12:00Z"
          },
          "year": {
            "type": "integer",
            "nullable": true,
            "description": "год регистрации (только aged)"
          }
        }
      },
      "OrdersList": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "total": {
            "type": "integer",
            "example": 37
          },
          "page_size": {
            "type": "integer",
            "example": 20
          },
          "page": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "OrderWrap": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "order": {
            "$ref": "#/components/schemas/Order"
          }
        }
      },
      "CodeResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "nullable": true,
            "example": "48213"
          }
        }
      },
      "TdataResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "tdata_url": {
            "type": "string",
            "description": "ссылка на tdata.zip, живёт 15 минут",
            "example": "https://matrix-project.org/api/v1/files/kQ7f2mN0vE3pT8xR-jL4wZsY6bH1oCdA"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "когда ссылка истечёт",
            "example": "2026-09-02T22:42:00Z"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/balance": {
      "get": {
        "tags": [
          "Баланс"
        ],
        "summary": "Баланс аккаунта",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          },
          "401": {
            "description": "Токен отсутствует или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "unauthorized",
                  "msg": "Токен отсутствует или недействителен"
                }
              }
            }
          },
          "429": {
            "description": "Превышена частота запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "rate_limited",
                  "msg": "Превышена частота запросов"
                }
              }
            }
          }
        },
        "operationId": "Balance.Get",
        "x-codeSamples": [
          {
            "lang": "shell",
            "label": "cURL",
            "source": "curl \"https://matrix-project.org/api/v1/balance\" \\\n  -H \"Authorization: Bearer $TOKEN\""
          },
          {
            "lang": "python",
            "label": "Python",
            "source": "import requests\n\nTOKEN = \"ВАШ_ТОКЕН\"\n\nresp = requests.get(\n    \"https://matrix-project.org/api/v1/balance\",\n    headers={\"Authorization\": f\"Bearer {TOKEN}\"},\n)\nresp.raise_for_status()\nprint(resp.json())"
          },
          {
            "lang": "javascript",
            "label": "JavaScript",
            "source": "const TOKEN = \"ВАШ_ТОКЕН\";\n\nconst res = await fetch(\"https://matrix-project.org/api/v1/balance\", {\n  headers: { Authorization: `Bearer ${TOKEN}` },\n});\nconsole.log(await res.json());"
          }
        ]
      }
    },
