          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersList"
                }
              }
            }
          },
          "401": {
            "description": "Токен отсутствует или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "unauthorized",
                  "msg": "Токен отсутствует или недействителен"
                }
              }
            }
          },
          "429": {
            "description": "Превышена частота запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "rate_limited",
                  "msg": "Превышена частота запросов"
                }
              }
            }
          }
        },
        "operationId": "Orders.List",
        "x-codeSamples": [
          {
            "lang": "shell",
            "label": "cURL",
            "source": "curl \"https://matrix-project.org/api/v1/orders?page=1\" \\\n  -H \"Authorization: Bearer $TOKEN\""
          },
          {
            "lang": "python",
            "label": "Python",
            "source": "import requests\n\nTOKEN = \"ВАШ_ТОКЕН\"\n\nresp = requests.get(\n    \"https://matrix-project.org/api/v1/orders\",\n    headers={\"Authorization\": f\"Bearer {TOKEN}\"},\n    params={\"page\": 1},\n)\nresp.raise_for_status()\nprint(resp.json())"
          },
          {
            "lang": "javascript",
            "label": "JavaScript",
            "source": "const TOKEN = \"ВАШ_ТОКЕН\";\n\nconst res = await fetch(\"https://matrix-project.org/api/v1/orders?page=1\", {\n  headers: { Authorization: `Bearer ${TOKEN}` },\n});\nconsole.log(await res.json());"
          }
        ]
      }
    },
