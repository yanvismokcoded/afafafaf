          },
          "401": {
            "description": "Токен отсутствует или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "unauthorized",
                  "msg": "Токен отсутствует или недействителен"
                }
              }
            }
          },
          "429": {
            "description": "Превышена частота запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "rate_limited",
                  "msg": "Превышена частота запросов"
                }
              }
            }
          }
        },
        "operationId": "Catalog.Prices",
        "x-codeSamples": [
          {
            "lang": "shell",
            "label": "cURL",
            "source": "curl \"https://matrix-project.org/api/v1/prices\" \\\n  -H \"Authorization: Bearer $TOKEN\""
          },
          {
            "lang": "python",
            "label": "Python",
            "source": "import requests\n\nTOKEN = \"ВАШ_ТОКЕН\"\n\nresp = requests.get(\n    \"https://matrix-project.org/api/v1/prices\",\n    headers={\"Authorization\": f\"Bearer {TOKEN}\"},\n)\nresp.raise_for_status()\nprint(resp.json())"
          },
          {
            "lang": "javascript",
            "label": "JavaScript",
            "source": "const TOKEN = \"ВАШ_ТОКЕН\";\n\nconst res = await fetch(\"https://matrix-project.org/api/v1/prices\", {\n  headers: { Authorization: `Bearer ${TOKEN}` },\n});\nconsole.log(await res.json());"
          }
        ]
      }
    },
    "/v1/buy": {
      "post": {
        "tags": [
          "Покупка"
        ],
        "summary": "Оформить покупку",
        "description": "Сервер сам находит самый дешёвый лот нужной категории и списывает его стоимость с баланса.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuyRequest"
              },
              "examples": {
                "Авторег Индия": {
                  "value": {
                    "kind": "newreg",
                    "country": "IN"
                  }
                },
                "Отлёга с годом": {
                  "value": {
                    "kind": "aged",
                    "country": "IN",
                    "year": 2019
                  }
                },
                "Отлёга, любая страна": {
                  "value": {
                    "kind": "aged"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Куплено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuyAccountResult"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры запроса либо не хватает баланса (`no_funds`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "no_funds",
                  "msg": "На балансе не хватает средств"
                }
              }
            }
          },
          "401": {
            "description": "Токен отсутствует или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "unauthorized",
                  "msg": "Токен отсутствует или недействителен"
                }
              }
            }
          },
          "409": {
            "description": "Нет в наличии (`no_stock`) или покупка не удалась — средства возвращены (`purchase_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "no_stock",
                  "msg": "Нет доступных аккаунтов по этому фильтру"
                }
              }
            }
          },
          "429": {
            "description": "Превышена частота запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "rate_limited",
                  "msg": "Превышена частота запросов"
                }
              }
            }
          }
        },
        "operationId": "Purchase.Buy",
        "x-codeSamples": [
          {
            "lang": "shell",
            "label": "cURL",
            "source": "curl -X POST \"https://matrix-project.org/api/v1/buy\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"kind\": \"newreg\", \"country\": \"IN\"}'"
          },
          {
            "lang": "python",
            "label": "Python",
            "source": "import requests\n\nTOKEN = \"ВАШ_ТОКЕН\"\n\nresp = requests.post(\n    \"https://matrix-project.org/api/v1/buy\",\n    headers={\"Authorization\": f\"Bearer {TOKEN}\"},\n    json={\"kind\": \"newreg\", \"country\": \"IN\"},\n)\nresp.raise_for_status()\nprint(resp.json())"
          },
          {
            "lang": "javascript",
            "label": "JavaScript",
            "source": "const TOKEN = \"ВАШ_ТОКЕН\";\n\nconst res = await fetch(\"https://matrix-project.org/api/v1/buy\", {\n  method: \"POST\",\n  headers: {\n    \"Authorization\": `Bearer ${TOKEN}`,\n    \"Content-Type\": \"application/json\",\n  },\n  body: JSON.stringify({\"kind\": \"newreg\", \"country\": \"IN\"}),\n});\nconsole.log(await res.json());"
          }
        ]
      }
    },
    "/v1/orders": {
      "get": {
